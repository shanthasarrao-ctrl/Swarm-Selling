{
  "_comment": "Placeholders. Fill with your own credentials. Nothing here is committed with real values — see SECURITY.md.",
  "mcpServers": {
    "salesforce": {
      "command": "npx",
      "args": ["-y", "@salesforce/mcp-server"],
      "env": {
        "SALESFORCE_INSTANCE_URL": "YOUR_INSTANCE_URL",
        "SALESFORCE_ACCESS_TOKEN": "YOUR_TOKEN"
      }
    },
    "gong": {
      "command": "npx",
      "args": ["-y", "@gong/mcp-server"],
      "env": {
        "GONG_ACCESS_KEY": "YOUR_KEY",
        "GONG_ACCESS_SECRET": "YOUR_SECRET"
      }
    },
    "gmail": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-gmail"],
      "env": { "GMAIL_CREDENTIALS": "YOUR_CREDENTIALS_PATH" }
    }
  }
}
